# =========================================================
# CO-LAB ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Application Info
VITE_APP_NAME="co-lab"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# Supabase Cloud Database Credentials
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Versioned Backend API Base
VITE_API_BASE_URL="/api/v1"

# Payment Gateway
VITE_PAYMENT_GATEWAY_KEY="rzp_test_your_key"

# ASCI / Compliance Scanner Active Flag
VITE_ENABLE_ASCI_AI_CHECK="true"
